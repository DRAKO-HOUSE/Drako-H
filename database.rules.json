{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "produtos": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": [
        "categoria"
      ],
      "$produtoId": {
        "disponivel": {
          ".validate": "newData.isBoolean()"
        },
        "destaque": {
          ".validate": "newData.isBoolean()"
        },
        "nome": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "descricao": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "precoM": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "precoG": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "adicionais": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$adicionalId": {
        ".validate": "newData.hasChildren(['nome', 'preco'])",
        "nome": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "preco": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "categorias": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$categoriaId": {
        ".validate": "newData.hasChildren(['nome', 'tipo', 'ordem'])",
        "nome": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "titulo": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "icone": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "tipo": {
          ".validate": "newData.val() === 'batatas' || newData.val() === 'combos' || newData.val() === 'simples'"
        },
        "ordem": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "bairros": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$bairroId": {
        ".validate": "newData.hasChildren(['nome', 'taxa'])",
        "nome": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "taxa": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "configuracoes": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "statusLoja": {
        ".validate": "newData.isBoolean()"
      },
      "inicializado": {
        ".validate": "newData.isBoolean()"
      },
      "entrega": {
        ".validate": "newData.hasChildren(['cobrarTaxa', 'modo', 'taxaUnica'])",
        "cobrarTaxa": {
          ".validate": "newData.isBoolean()"
        },
        "modo": {
          ".validate": "newData.val() === 'unica' || newData.val() === 'bairro'"
        },
        "taxaUnica": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$outro": {
          ".validate": false
        }
      },
      "restaurante": {
        ".validate": "newData.hasChildren(['nome', 'whatsapp'])",
        "nome": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "whatsapp": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{12,13}$/)"
        },
        "horario": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "mensagemWhatsapp": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "$outro": {
          ".validate": false
        }
      },
      "aparencia": {
        ".validate": "newData.hasChildren(['versao', 'cores', 'tema', 'atualizadoEm'])",
        "versao": {
          ".validate": "newData.isNumber()"
        },
        "paleta": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "cores": {
          ".validate": "newData.hasChildren(['primaria', 'secundaria', 'destaque', 'fundo'])",
          "primaria": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)"
          },
          "secundaria": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)"
          },
          "destaque": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)"
          },
          "fundo": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)"
          },
          "$outro": {
            ".validate": false
          }
        },
        "tema": {
          ".validate": "newData.val() === 'claro' || newData.val() === 'escuro' || newData.val() === 'auto'"
        },
        "logo": {
          "src": {
            ".validate": "newData.isString() && newData.val().length <= 450000"
          },
          "largura": {
            ".validate": "newData.isNumber() && newData.val() >= 40 && newData.val() <= 200"
          },
          "$outro": {
            ".validate": false
          }
        },
        "cabecalho": {
          "tipo": {
            ".validate": "newData.val() === 'cor' || newData.val() === 'gradiente' || newData.val() === 'imagem'"
          },
          "cor": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          },
          "gradiente": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "imagem": {
            ".validate": "newData.isString() && newData.val().length <= 450000"
          },
          "escurecimento": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "$outro": {
            ".validate": false
          }
        },
        "atualizadoEm": {
          ".validate": "newData.isNumber()"
        },
        "atualizadoPor": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "$outro": {
          ".validate": false
        }
      },
      "aparenciaHistorico": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$versaoId": {
          ".validate": "newData.hasChildren(['cores', 'tema', 'atualizadoEm'])"
        }
      }
    },
    "clientes": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$telefone": {
        ".write": "newData.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "$telefone.matches(/^[0-9]{10,13}$/) && newData.hasChildren(['nome', 'telefone', 'atualizadoEm']) && newData.child('telefone').val() === $telefone",
        "nome": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "telefone": {
          ".validate": "newData.isString()"
        },
        "endereco": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "numero": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "bairro": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "referencia": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "atualizadoEm": {
          ".validate": "newData.isNumber()"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "pedidos": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": [
        "criadoEm",
        "status"
      ],
      "$pedidoId": {
        ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (!data.exists() && newData.child('status').val() === 'Novo')",
        ".validate": "newData.hasChildren(['codigo', 'criadoEm', 'status', 'tipo', 'cliente', 'itens', 'subtotal', 'taxa', 'total', 'pagamento'])",
        "codigo": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "criadoEm": {
          ".validate": "newData.isNumber()"
        },
        "atualizadoEm": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.val() === 'Novo' || newData.val() === 'Em preparo' || newData.val() === 'Saiu para entrega' || newData.val() === 'Entregue' || newData.val() === 'Cancelado'"
        },
        "tipo": {
          ".validate": "newData.val() === 'entrega' || newData.val() === 'retirada'"
        },
        "cliente": {
          ".validate": "newData.hasChildren(['nome', 'telefone'])",
          "nome": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "telefone": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{10,13}$/)"
          },
          "endereco": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "numero": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "bairro": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "referencia": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "$outro": {
            ".validate": false
          }
        },
        "itens": {
          ".validate": "newData.hasChildren()",
          "$indice": {
            ".validate": "newData.hasChildren(['nome', 'qtd', 'subtotal'])",
            "nome": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
            },
            "qtd": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
            },
            "subtotal": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "observacao": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            }
          }
        },
        "subtotal": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "taxa": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "total": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "pagamento": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "troco": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "pedidosStatus": {
      "$pedidoId": {
        ".read": true,
        ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (!data.exists() && newData.child('status').val() === 'Novo')",
        ".validate": "newData.hasChildren(['codigo', 'criadoEm', 'status', 'tipo', 'total'])",
        "codigo": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "criadoEm": {
          ".validate": "newData.isNumber()"
        },
        "atualizadoEm": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.val() === 'Novo' || newData.val() === 'Em preparo' || newData.val() === 'Saiu para entrega' || newData.val() === 'Entregue' || newData.val() === 'Cancelado'"
        },
        "tipo": {
          ".validate": "newData.val() === 'entrega' || newData.val() === 'retirada'"
        },
        "itensResumo": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "total": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$outro": {
          ".validate": false
        }
      }
    }
  }
}